# Contact form — copy this file to `.env.local` for local dev, and add the same
# three variables in Vercel under Settings → Environment Variables.
#
# None of these are prefixed with NEXT_PUBLIC_, so they stay on the server and
# never reach the browser bundle.

# From https://resend.com/api-keys — "Sending access" permission is enough.
# Shown once at creation; if you lose it, delete the key and make a new one.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries land. This is the existing Cloudflare Email Routing address
# that forwards to the personal inbox.
CONTACT_TO_EMAIL=info@ivan-martinez.org

# The sender. Any address on a domain verified in Resend works — it does NOT
# need a real mailbox behind it, which is why this differs from the TO address.
# Keeping From ≠ To stops every enquiry from appearing to come from yourself.
CONTACT_FROM_EMAIL="Portfolio <portfolio@ivan-martinez.org>"
